# ── Copy to .env inside each service folder and fill in. Never commit .env. ──

# ── backend/ ──────────────────────────────────────────────
# LLM for document extraction (pick one, or use OpenRouter for all)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Database (Railway Postgres URL, or leave empty for in-memory mock mode)
DATABASE_URL=
# CORS origin of the dashboard in prod
DASHBOARD_ORIGIN=http://localhost:5173

# ── whatsapp-bot/ ─────────────────────────────────────────
# Meta WhatsApp Cloud API (sach batao number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aitabaar-verify
# Where the bot sends applications
BACKEND_API_URL=http://localhost:8000

# ── dashboard/ ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
