# ── Copy to .env inside each service folder and fill in. Never commit .env. ──

# ── backend/ ──────────────────────────────────────────────
# LLM for document extraction (pick one, or use OpenRouter for all)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Database (Railway Postgres URL, or leave empty for in-memory mock mode)
DATABASE_URL=
# CORS origin of the dashboard in prod
DASHBOARD_ORIGIN=http://localhost:5173

# ── whatsapp-bot/ (see whatsapp-bot/.env.example for details) ──
PORT=8001
SESSION_DIR=./.wwebjs_auth
BACKEND_API_URL=http://localhost:8000

# ── dashboard/ ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
