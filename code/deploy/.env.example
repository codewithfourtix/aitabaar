# Copy to .env on the VM and fill in.  (cp .env.example .env)

# OpenRouter key — needed for the LIVE WhatsApp photo path (real vision
# extraction + LLM briefs). The 3 demo applicants via /demo/reset work
# WITHOUT it. Get one at https://openrouter.ai/keys and add a few $ credit.
OPENROUTER_API_KEY=

# Leave 0 for the real demo. Set 1 to force deterministic template briefs
# everywhere (no LLM calls at all).
AITABAAR_OFFLINE=0

# HTTPS hostnames via nip.io — replace with YOUR VM's public IP.
# nip.io resolves <anything>.<ip>.nip.io to <ip>, so no domain to buy.
# Example: if your VM public IP is 140.238.1.2 :
#   API_DOMAIN=api.140.238.1.2.nip.io
#   QR_DOMAIN=qr.140.238.1.2.nip.io
API_DOMAIN=
QR_DOMAIN=
