# ── Copy to .env inside each service folder and fill in. Never commit .env. ──

# ── backend/ ──────────────────────────────────────────────
# LLM for document extraction + brief writing, via OpenRouter (openrouter.ai/keys).
# Budget a few $ of real credit — the 2.0 Flash free tier was deprecated
# June 2026 and free-tier models/limits shift monthly. Without a key the
# extraction/brief stages fall back to templates (no crash).
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
# No DB for the hackathon demo (docs/decisions.md #18) — in-memory store.
DATABASE_URL=
# CORS origin of the dashboard in prod
DASHBOARD_ORIGIN=http://localhost:5173

# ── whatsapp-bot/ (see whatsapp-bot/.env.example for details) ──
PORT=8001
SESSION_DIR=./.wwebjs_auth
BACKEND_API_URL=http://localhost:8000

# ── dashboard/ ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
