# Copy to .env for local dev. On Railway these are service variables.
PORT=8001

# Applicant channel: twilio | wwebjs
#   twilio  = Twilio Business API webhook. No Chromium, no QR, no ban risk.
#             Testers must send the sandbox join code once. Recommended.
#   wwebjs  = whatsapp-web.js + Chromium, linked by scanning /qr. Fallback.
CHANNEL=twilio

# --- Twilio channel (CHANNEL=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number, as Twilio addresses it
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Two-word code testers send ("join <code>"); shown on / and used for the wa.me link
TWILIO_SANDBOX_JOIN_CODE=
# Pin the URL used for webhook signature checks if a proxy rewrites it.
# Leave empty to reconstruct from x-forwarded-proto/host.
TWILIO_WEBHOOK_URL=
# Set to false only if signature checks reject valid Twilio requests
TWILIO_VALIDATE_SIGNATURE=true

# --- Backend ---
BACKEND_API_URL=http://localhost:8000

# --- whatsapp-web.js channel (CHANNEL=wwebjs) ---
# Where the WhatsApp session is stored. Local default is fine for dev.
# On Railway set this to the mounted volume: /data/wwebjs_auth
SESSION_DIR=./.wwebjs_auth
# Set in Docker/Railway (Dockerfile sets it); leave empty locally to use bundled Chromium
PUPPETEER_EXECUTABLE_PATH=
