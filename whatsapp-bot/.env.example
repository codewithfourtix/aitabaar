# Copy to .env for local dev. On Railway these are service variables.
PORT=8001
# Where the WhatsApp session is stored. Local default is fine for dev.
# On Railway set this to the mounted volume: /data/wwebjs_auth
SESSION_DIR=./.wwebjs_auth
# Backend API base URL
BACKEND_API_URL=http://localhost:8000
# Set in Docker/Railway (Dockerfile sets it); leave empty locally to use bundled Chromium
PUPPETEER_EXECUTABLE_PATH=
